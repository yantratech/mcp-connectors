{
  "name": "@yantratech/kandji-mcp-server",
  "version": "0.1.0",
  "description": "Iru Endpoint (formerly Kandji) MCP server — 114 tools for Apple device management: inventory, MDM actions, Prism fleet reporting, blueprints, library items, threats and vulnerabilities",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yantratech/mcp-connectors.git",
    "directory": "connectors/kandji"
  },
  "author": "Yantra Applied Technologies Limited (https://yantratech.com)",
  "type": "module",
  "bin": {
    "kandji-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('node:fs');for(const f of fs.readdirSync('dist'))if(f.endsWith('.js'))fs.chmodSync('dist/'+f,0o755)\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "lint:fix": "eslint --fix",
    "lint": "eslint .",
    "test": "node --test test/e2e.test.js test/tools-list.test.js test/fix-audit.test.js test/id-encoding.test.js",
    "test:live": "node test/live-bugfix-smoke.js",
    "test:live:writes": "node test/live-write-tools.test.js",
    "test:live:create-blueprint": "node test/live-create-blueprint.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.10",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0"
  },
  "bugs": "https://github.com/yantratech/mcp-connectors/issues",
  "homepage": "https://github.com/yantratech/mcp-connectors/tree/main/connectors/kandji#readme",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "kandji",
    "iru",
    "mdm",
    "apple",
    "device-management",
    "claude"
  ]
}
