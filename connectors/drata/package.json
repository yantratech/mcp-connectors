{
  "name": "@yantratech/drata-mcp-server",
  "version": "0.1.0",
  "description": "Drata MCP server — SOC 2 gap analysis, evidence management, and compliance automation",
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yantratech/mcp-connectors.git",
    "directory": "connectors/drata"
  },
  "author": "Yantra Applied Technologies Limited (https://yantratech.com)",
  "type": "module",
  "bin": {
    "drata-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs=require('node:fs');for(const f of fs.readdirSync('dist'))if(f.endsWith('.js'))fs.chmodSync('dist/'+f,0o755)\"",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "lint:fix": "eslint --fix",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "smoke:read": "node test/live-read-smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "drata",
    "soc2",
    "compliance",
    "grc",
    "audit",
    "claude"
  ],
  "bugs": "https://github.com/yantratech/mcp-connectors/issues",
  "homepage": "https://github.com/yantratech/mcp-connectors/tree/main/connectors/drata#readme"
}
