# =============================================================================
# yantra-spend MCP server configuration
# Every source's credentials are independently optional — a source without
# credentials is skipped, and the health tool shows which sources are set up.
#
# Copy to connectors/yantra-spend/.env. The server reads that file only when
# it runs from a source checkout (dist/index.js loads ../.env). Under npx it
# is not read: set these variables in your MCP client's env block instead.
# =============================================================================

# --- AWS Cost Explorer -----------------------------------------------------
# IAM user/role with the policy in docs/iam/aws-readonly-policy.json.
# Cost Explorer endpoint is region-pinned to us-east-1 even if your workloads run elsewhere.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Azure Cost Management -------------------------------------------------
# Service principal with Cost Management Reader (or the narrower custom role)
# on the listed subscriptions. Setup commands: docs/iam/azure-sp-setup.md.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Comma-separated list of subscription IDs to query.
AZURE_SUBSCRIPTION_IDS=

# --- Anthropic admin API ---------------------------------------------------
# Org admin key, starts sk-ant-admin-...
# Mint at https://console.anthropic.com → Settings → Admin Keys.
ANTHROPIC_ADMIN_KEY=

# --- OpenAI admin API ------------------------------------------------------
# Admin key from https://platform.openai.com → Settings → Organization → Admin Keys.
OPENAI_ADMIN_KEY=
OPENAI_ORG_ID=

# --- Cursor admin API ------------------------------------------------------
# Cursor Business / Team admin API key. Mint at:
#   cursor.com/dashboard → Settings → Admin API Keys
# Used as the username in HTTP Basic auth (with empty password) — see
# https://cursor.com/docs/account/teams/admin-api. NOT a Bearer token.
CURSOR_ADMIN_API_KEY=

# --- FX --------------------------------------------------------------------
# USD remains the canonical figure on every CostLine; GBP is opt-in per call.
# When currency=GBP is requested, the rate is fetched from FX_PROVIDER_URL and
# cached in-process for FX_CACHE_TTL_SECONDS. Default provider is Frankfurter
# (ECB-backed, no API key required); response shape is `{rates: {GBP: <num>}}`.
FX_PROVIDER_URL=https://api.frankfurter.dev/v1/latest?from=USD&to=GBP
FX_CACHE_TTL_SECONDS=60
# Optional override (useful in CI / offline). When set, no HTTP call is made.
FX_GBP_PER_USD_OVERRIDE=
