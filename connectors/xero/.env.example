# Xero API Configuration for Custom Connections (Mode 1: client_credentials)
XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_here

# Mode 2: Bearer token (alternative to CLIENT_ID/SECRET).
# Provide a pre-issued Xero access token that already carries the required
# scopes. When set, this takes precedence over the client_credentials flow.
# XERO_CLIENT_BEARER_TOKEN=your_access_token_here 

# Optional: absolute path of a directory whose files upload_file and
# upload_attachment (filePath) may read. Unset = prepare_attachment files only.
# XERO_UPLOAD_DIR=/absolute/path/to/upload-dir

# Optional: set to 1 to enable the receipt tools. This also requests the
# deprecated accounting.transactions(.read) scopes, which Custom Connections
# created on or after 29 April 2026 cannot be granted.
# XERO_ENABLE_RECEIPTS=1

# Optional: set to 1 to enable the journal tools (list_journals, get_journal).
# This also requests accounting.journals.read, which Xero does not grant to
# Custom Connections created on or after 29 April 2026 unless it grants them
# Advanced access.
# XERO_ENABLE_JOURNALS=1
