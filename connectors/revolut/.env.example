# Revolut Business MCP server configuration.
# Copy the relevant values into your MCP client config (e.g. claude_desktop_config.json)
# under mcpServers.revolut-business.env — this file documents the variables.

# Environment: "sandbox" (default) or "production".
# The server REFUSES to start in production unless this is explicitly set to
# "production". Build and test everything against sandbox first.
REVOLUT_ENV=sandbox

# ClientID copied from the API certificate details in the Revolut Business web
# app (Settings -> APIs -> Business API -> your certificate).
REVOLUT_CLIENT_ID=your_client_id_here

# Absolute path to the RSA private key (PEM) whose public cert was uploaded to
# Revolut. Keep this file at mode 0600, outside the repo. Never commit it.
REVOLUT_PRIVATE_KEY_PATH=/Users/you/.revolut-mcp/privatecert.pem

# The redirect-URI domain, WITHOUT the scheme (no "https://"). Used as the JWT
# "iss" claim. e.g. example.com
REVOLUT_JWT_ISS=example.com

# Human operator name stamped onto every payment draft title, e.g. "alice".
# Required and non-empty. This attribution is not controllable by the LLM.
REVOLUT_OPERATOR=your_name_here
